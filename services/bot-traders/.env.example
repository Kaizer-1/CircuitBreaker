# Copy to .env to run this service outside Docker. `.env` is git-ignored; only this example is committed.
# Inside Docker Compose these values are set by docker-compose.yml, so you do not need a .env.
LOG_LEVEL=INFO
ENVIRONMENT=dev
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# The public API (bots get no shortcuts). Inside Compose: http://api-gateway:8000
GATEWAY_URL=http://localhost:8080
# Local-development placeholder (the gateway's BOT_SECRET in docker-compose.yml)
BOT_SECRET=cb-dev-bot-secret
# Off by default; `make bots` turns them on. A seed makes rehearsals repeat; activity scales the rate.
BOTS_ENABLED=false
BOT_RANDOM_SEED=
BOT_ACTIVITY=1.0
