# Copy to .env to run this service outside Docker. `.env` is git-ignored; only this example is committed.
# Inside Docker Compose these values are set by docker-compose.yml, so you do not need a .env.
LOG_LEVEL=INFO
ENVIRONMENT=dev
# JSON map of upstream service name -> base URL. Defaults to the host ports of `make up`.
# SERVICE_UPSTREAMS={"order-service":"http://localhost:8001"}
UPSTREAM_TIMEOUT_SECONDS=5
STATUS_TIMEOUT_SECONDS=2
# Secrets: local-development placeholders (the same as docker-compose.yml). Never real values.
JWT_SECRET=cb-dev-jwt-secret-for-local-compose-only
BOT_SECRET=cb-dev-bot-secret
ADMIN_PASSCODE=cb-dev-admin-passcode
SESSION_HOURS=12
