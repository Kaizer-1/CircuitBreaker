# Copy to .env to run this service outside Docker. `.env` is git-ignored; only this example is committed.
# Inside Docker Compose these values are set by docker-compose.yml, so you do not need a .env.
LOG_LEVEL=INFO
ENVIRONMENT=dev
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=order_service
CASSANDRA_USERNAME=order_service_role
# Local-development placeholder created by dev/cassandra/init-keyspaces.sh
CASSANDRA_PASSWORD=cb_dev_order_service
# A-06: the synchronous reservation, 500 ms timeout, circuit breaker (ADR-0011)
PORTFOLIO_URL=http://localhost:8004
RESERVATION_TIMEOUT_SECONDS=0.5
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=10
PUBLISH_TIMEOUT_SECONDS=60
# The Kafka client drops a message it could not deliver within this; the relay starts no OrderPlaced
# send after 60 - 10 s (ADR-0017)
PUBLISH_DELIVERY_TIMEOUT_SECONDS=10
RELAY_INTERVAL_SECONDS=2
