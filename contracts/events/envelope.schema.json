{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitbreaker.local/contracts/events/envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "correlation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID; consumers deduplicate on it"
    },
    "event_type": {
      "type": "string",
      "description": "PascalCase past-tense name, e.g. TradeExecuted"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC, millisecond precision"
    },
    "producer": {
      "type": "string",
      "enum": [
        "order-service",
        "matching-engine",
        "market-data-service",
        "sre-agent"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "correlation_id": {
      "type": "string",
      "description": "From the X-Correlation-Id of the originating request"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "event_id of the event that caused this one"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$comment": "Generated from docs/03-architecture/03-event-catalog.md by tools/check_event_contracts.py --write. Do not edit by hand: change the catalog and regenerate."
}
