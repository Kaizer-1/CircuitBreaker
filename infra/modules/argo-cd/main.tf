# Argo CD, the GitOps deployment server (ADR-0014), as in the textbook's module-argo-cd (Mitra & Nadareishvili,
# Ch. 7): installed with Terraform's Helm provider. Then what it deploys: one Application per service (and per data
# store) per environment, generated by an ApplicationSet from deploy/envs/<env>/ in Git.

terraform {
  required_providers {
    helm = {
      source = "hashicorp/helm"
    }
    kubernetes = {
      source = "hashicorp/kubernetes"
    }
  }
}

resource "kubernetes_namespace_v1" "argocd" {
  metadata {
    name = "argocd"
  }
}

# The bootstrap secret: Argo CD's read-only deploy key for this private repository. It cannot be a SealedSecret in
# Git, because Argo CD needs it to read Git in the first place (and the SealedSecrets reach the cluster through Argo
# CD). So it comes from a Terraform variable (git-ignored tfvars) and therefore sits in Terraform's state, which is
# one reason the state file is git-ignored and stays on this laptop.
resource "kubernetes_secret_v1" "repository" {
  metadata {
    name      = "circuitbreaker-repo"
    namespace = kubernetes_namespace_v1.argocd.metadata[0].name
    labels = {
      "argocd.argoproj.io/secret-type" = "repository"
    }
  }
  # CI's throwaway cluster reads Git over HTTPS with the job's own short-lived token instead.
  data = var.repo_https_token == null ? {
    type          = "git"
    url           = var.repo_url
    sshPrivateKey = var.repo_ssh_private_key
    } : {
    type     = "git"
    url      = var.repo_url
    username = "x-access-token"
    password = var.repo_https_token
  }
}

resource "helm_release" "argo_cd" {
  name       = "argo-cd"
  chart      = "${var.chart_cache}/argo-cd-10.18.2.tgz"
  namespace  = kubernetes_namespace_v1.argocd.metadata[0].name
  values     = [file("${var.repo_root}/infra/platform/argo-cd.yaml")]
  wait       = true
  timeout    = 600
  depends_on = [kubernetes_secret_v1.repository]
}

locals {
  applications_chart = "${path.module}/applications"
  # Helm reinstalls a local chart only when its version or values change; this value changes with any file in it.
  applications_checksum = sha256(join("", [
    for f in sort(fileset(local.applications_chart, "**")) : filesha256("${local.applications_chart}/${f}")
  ]))
}

# The AppProject, the ApplicationSets and the observability Application, as a small chart in this module. A second
# release, after Argo CD's own, because its objects need Argo CD's CRDs to exist first.
resource "helm_release" "applications" {
  name      = "circuitbreaker-applications"
  chart     = local.applications_chart
  namespace = kubernetes_namespace_v1.argocd.metadata[0].name
  values = [yamlencode({
    repoURL        = var.repo_url
    targetRevision = var.target_revision
    environments   = var.environments
    checksum       = local.applications_checksum
    # The ci profile: no Sealed Secrets controller, no monitoring, no Traefik on the runner.
    sealedSecrets   = var.profile == "full"
    observability   = var.profile == "full"
    skipComponents  = var.profile == "full" ? [] : ["ingress"]
    extraValueFiles = var.profile == "full" ? [] : ["../../deploy/profiles/${var.profile}.yaml"]
  })]
  depends_on = [helm_release.argo_cd]
}

# Destroy order. Every Application carries Argo CD's resources-finalizer: on delete, Argo CD first removes what the
# Application deployed, then lets it go. Argo CD does that only while it runs AND the Application's project exists,
# so the Applications must go before the release above (which holds the AppProject) and before Argo CD itself.
# Depending on that release, this is destroyed first: it deletes the ApplicationSets and Applications and waits.
# Found by CI's platform check (2026-11-24): otherwise the argocd namespace hangs in Terminating.
resource "terraform_data" "teardown" {
  input = var.repo_root

  provisioner "local-exec" {
    when    = destroy
    command = "python3 ${self.input}/scripts/k8s.py argo-teardown --timeout 600"
  }
  depends_on = [helm_release.applications]
}
