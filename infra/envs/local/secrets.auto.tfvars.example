# Copy to secrets.auto.tfvars (git-ignored) and fill in. Terraform reads it automatically.
# These are the platform's own secrets, needed before Argo CD can read anything from Git; every other secret is a
# SealedSecret in deploy/envs/<env>/sealed/ (ADR-0019).

grafana_admin_password = "change-me"

# Argo CD's read-only deploy key; the default path is private/keys/argocd-deploy-key.
# repo_ssh_private_key_file = "/path/to/another/key"
