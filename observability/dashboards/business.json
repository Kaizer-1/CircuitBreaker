        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\",service=\"order-service\",route=\"/v1/orders\",method=\"POST\",status=~\"2..\"}[1m])) / sum(rate(http_requests_total{namespace=\"$namespace\",service=\"order-service\",route=\"/v1/orders\",method=\"POST\"}[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
