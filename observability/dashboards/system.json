          "expr": "max by (pod) (kube_pod_status_ready{namespace=\"$namespace\",condition=\"true\"} * on (pod) group_left() max by (pod) (kube_pod_status_phase{namespace=\"$namespace\",phase=~\"Running|Pending\"} == 1))",
