    {
      "id": 32,
      "type": "timeseries",
      "title": "Memory as % of the limit",
      "description": "MarketDataMemoryGrowth fires when market-data-service is above 70% of its limit and still rising. Data stores never count: Cassandra's JVM keeps its memory by design (it sits near 70% all the time), and the SRE agent never acts on a data store.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\"} / (container_spec_memory_limit_bytes{namespace=\"$namespace\",container!=\"\"} > 0))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
