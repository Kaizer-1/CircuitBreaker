                "1": {
                  "text": "ready",
                  "color": "#45d07a",
                  "index": 0
                },
                "0": {
                  "text": "not ready",
                  "color": "#ff5c5c",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
