{
  "uid": "cb-incident-view",
  "title": "CircuitBreaker \u2014 Incident view",
  "description": "The projector's view of the chaos scenarios: one large panel each, the agent's budget and every alert, with every deploy, chaos experiment and agent action marked (Phase 7c).",
  "tags": [
    "circuitbreaker"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Environment",
        "type": "custom",
        "query": "prod,staging",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Agent actions",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "#ffa028",
        "expr": "{namespace=\"$namespace\",app=\"sre-agent\"} |= \"action executed\" | json",
        "titleFormat": "Agent: {{action}} {{target_service}}",
        "textFormat": "{{incident_id}}: {{details}}",
        "tagKeys": "incident_id"
      },
      {
        "name": "Chaos experiments",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "#ff5c5c",
        "expr": "{namespace=\"$namespace\",app=\"chaos-service\"} |~ \"ChaosExperiment(Started|Ended)\" | json",
        "titleFormat": "{{message}} {{scenario}}",
        "textFormat": "{{experiment_id}} {{outcome}}"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#a39d90",
        "expr": "changes(kube_deployment_metadata_generation{namespace=\"$namespace\"}[30s]) > 0",
        "step": "10s",
        "titleFormat": "{{deployment}} changed",
        "textFormat": "A new spec (a rollout, a rollback, a restart or a scale)."
      }
    ]
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "circuitbreaker"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Bad deploy \u00b7 order-service errors by type",
      "description": "Share of order-service requests answered with 5xx, by error code. A bad release shows as INTERNAL_ERROR; a traffic spike as OVERLOADED; a failing portfolio-service as DEPENDENCY_UNAVAILABLE. Dashed: the alert's 5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(http_problems_total{namespace=\"$namespace\",service=\"order-service\",status=~\"5..\"}[30s])) / scalar(sum(rate(http_requests_total{namespace=\"$namespace\",service=\"order-service\",route!~\"/healthz|/readyz|/metrics\"}[30s])) > 0)",
          "legendFormat": "{{code}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6f6a60"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 18,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#ff5c5c",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "INTERNAL_ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff5c5c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OVERLOADED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffa028"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DEPENDENCY_UNAVAILABLE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#a39d90"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory leak \u00b7 market-data-service memory",
      "description": "market-data-service's working set as a share of its memory limit. Dashed: the alert's 70% (it also needs the memory rising). A restart drops it to its normal level.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(container_memory_working_set_bytes{namespace=\"$namespace\",container=\"market-data-service\"}) / max(container_spec_memory_limit_bytes{namespace=\"$namespace\",container=\"market-data-service\"} > 0)",
          "legendFormat": "memory of limit",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6f6a60"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#ff5c5c",
                "value": 0.7
              }
            ]
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "memory of limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffa028"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Panic sell \u00b7 order latency and replicas",
      "description": "p95 of order-service's requests (left; dashed: the alert's 500 ms) and its ready replicas (right). The agent scales from 2 to at most 5.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\",service=\"order-service\",route!~\"/healthz|/readyz|/metrics\"}[30s])))",
          "legendFormat": "p95 latency",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=\"order-service\"})",
          "legendFormat": "ready replicas",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6f6a60"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#ff5c5c",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 latency"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffa028"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ready replicas"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#45d07a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ready replicas"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "off"
                }
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Database degraded \u00b7 the breaker and slow transactions",
      "description": "order-service's circuit breaker to portfolio-service (right: 1 = open) and portfolio-service's database transactions slower than 0.5 s, per second (left). The cause is a data store: the agent may never touch it, so it escalates.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(postgres_transaction_seconds_count{namespace=\"$namespace\",phase=\"transaction\"}[1m])) - sum(rate(postgres_transaction_seconds_bucket{namespace=\"$namespace\",phase=\"transaction\",le=\"0.5\"}[1m]))",
          "legendFormat": "slow transactions/s",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(circuit_breaker_state{namespace=\"$namespace\",dependency=\"portfolio-service\",state=\"open\"})",
          "legendFormat": "breaker open",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6f6a60"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6f6a60",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "slow transactions/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffa028"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "breaker open"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff5c5c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "breaker open"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.thresholdsStyle",
                "value": {
                  "mode": "off"
                }
              },
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "The agent \u00b7 budget and cooldowns",
      "description": "Actions the agent's hourly budget still allows (left, of 6) and the seconds left of each service's 5-minute cooldown after an action (right). The guardrails read them; nobody can change them at run time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(sre_agent_actions_left_this_hour{namespace=\"$namespace\"})",
          "legendFormat": "actions left this hour",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (sre_agent_cooldown_seconds{namespace=\"$namespace\"}) > 0",
          "legendFormat": "cooldown {{service}}",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6f6a60"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 8,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6f6a60",
                "value": null
              }
            ]
          },
          "max": 6
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actions left this hour"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#45d07a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "cooldown.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffa028"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Alerts firing \u00b7 what the agent sees",
      "description": "Every alert while it fires in this environment. The agent opens an incident for an application service's alert; data stores never trigger it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (alertname) (ALERTS{namespace=\"$namespace\",alertstate=\"firing\"})",
          "legendFormat": "{{alertname}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#ff5c5c",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "firing",
                  "color": "#ff5c5c"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
